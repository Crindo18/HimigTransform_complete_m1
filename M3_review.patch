@@ -27,8 +27,9 @@ function Cfg = enhancedConfig()
 %
 %   Blueprint: sections 0 (D4), 3.3, 3.4, 3.6, 7 (M4-M5), 8.2.
 
-Cfg = defaultConfig();
+Cfg = baselineConfig();
 
